# Copy to .env and fill in what you have. The app runs WITHOUT any of these:
# the agent falls back to a deterministic, offline "explain + draft" mode.

# Which provider the explain/draft agent should use.
# one of: auto | groq | openrouter | none
#   auto -> use Groq if GROQ_API_KEY is set, else OpenRouter, else offline.
BAHI_AGENT_BACKEND=auto

# --- Groq (https://console.groq.com/keys) -----------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenRouter (https://openrouter.ai/keys) --------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Data privacy: mask vendor names before any remote model call.
BAHI_REDACT_PII=true
